{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Ces deux entrées désignent des sous-chemins de paquets réels et non des
    // dossiers `@types` : y appliquer `typeRoots` les rendrait introuvables.
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src"]
}
