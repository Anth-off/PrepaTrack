# Copie ce fichier en .env.local et remplis la valeur.
# .env.local est ignoré par git : le mot de passe n'en sortira jamais.
#
# Où la trouver : Supabase → Project Settings → Database → Connection string,
# onglet URI. Remplace [YOUR-PASSWORD] par le mot de passe choisi à la création
# du projet.
#
# Sert uniquement à `npm run db:setup`. L'application, elle, n'utilise jamais
# cette adresse : elle passe par l'API publique protégée par les règles RLS.

SUPABASE_DB_URL=postgresql://postgres.xxxxx:MOTDEPASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
